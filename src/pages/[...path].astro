---
/**
 * One route file generates every page for every locale:
 *   /                     home            /ko
 *   /c/<category>         category hub    /ko/c/<category>
 *   /<tool>               tool            /ko/<tool>
 *   /<tool>/<variant>     tool preset     /ko/<tool>/<variant>
 *   /about /privacy       static page     /ko/about /ko/privacy
 *   /terms /contact                       /ko/terms /ko/contact
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolPage from '../components/site/ToolPage.astro';
import ToolCard from '../components/site/ToolCard.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import Icon from '../components/site/Icon.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../i18n/locales';
import { t } from '../i18n/ui';
import { localePath } from '../lib/urls';
import { breadcrumbLd, websiteLd } from '../lib/seo';
import { CONTACT_EMAIL } from '../config/site';
import { CATEGORIES, CATEGORY_IDS, type CategoryId } from '../tools/categories';
import { TOOLS } from '../tools/registry';
import type { ToolModule, ToolVariant } from '../tools/types';
import { homeCategorySections, popularTools, sortByLocalizedName } from '../tools/home';
import { buildSearchIndex } from '../lib/searchIndex';
import { STATIC_PAGE_IDS, STATIC_PAGES } from '../static-pages/content';
import type { StaticPageId } from '../static-pages/types';

type PageProps =
  | { kind: 'home'; locale: Locale }
  | { kind: 'category'; locale: Locale; category: CategoryId }
  | { kind: 'tool'; locale: Locale; tool: ToolModule; variant?: ToolVariant }
  | { kind: 'static'; locale: Locale; page: StaticPageId };

export const getStaticPaths = (() => {
  const paths: { params: { path: string | undefined }; props: PageProps }[] = [];
  const toPath = (locale: Locale, ...segments: string[]) => {
    const parts = locale === DEFAULT_LOCALE ? segments : [locale, ...segments];
    return parts.length ? parts.join('/') : undefined;
  };

  for (const locale of LOCALES) {
    paths.push({ params: { path: toPath(locale) }, props: { kind: 'home', locale } });

    for (const category of CATEGORY_IDS) {
      if (!TOOLS.some((tool) => tool.meta.category === category)) continue;
      paths.push({
        params: { path: toPath(locale, 'c', category) },
        props: { kind: 'category', locale, category },
      });
    }

    for (const tool of TOOLS) {
      paths.push({ params: { path: toPath(locale, tool.meta.slug) }, props: { kind: 'tool', locale, tool } });
      for (const variant of tool.meta.variants ?? []) {
        paths.push({
          params: { path: toPath(locale, tool.meta.slug, variant.slug) },
          props: { kind: 'tool', locale, tool, variant },
        });
      }
    }

    for (const page of STATIC_PAGE_IDS) {
      paths.push({ params: { path: toPath(locale, page) }, props: { kind: 'static', locale, page } });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

const props = Astro.props as PageProps;
const { locale } = props;

const popular = props.kind === 'home' ? popularTools(TOOLS) : [];
const homeSections = props.kind === 'home' ? homeCategorySections(TOOLS) : [];
const searchIndex = props.kind === 'home' ? buildSearchIndex(TOOLS, locale) : [];
const categoryTools =
  props.kind === 'category'
    ? sortByLocalizedName(
        TOOLS.filter((tool) => tool.meta.category === props.category),
        locale,
      )
    : [];
---

{props.kind === 'tool' && <ToolPage tool={props.tool} locale={locale} variant={props.variant} />}

{props.kind === 'home' && (
  <BaseLayout
    locale={locale}
    title={`${t(locale, 'home.h1')} — ${t(locale, 'site.tagline')}`}
    description={t(locale, 'site.description')}
    segments={[]}
    brandTitle={false}
    jsonLd={[websiteLd(locale, t(locale, 'site.description'))]}
  >
    <div class="mx-auto max-w-5xl px-4">
      <section class="pt-14 pb-10 max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-balance">{t(locale, 'home.h1')}</h1>
        <p class="mt-4 text-lg text-muted text-pretty">{t(locale, 'site.description')}</p>
        <div class="relative mt-8" data-search-root>
          <label class="flex items-center gap-2 rounded-lg border border-line bg-surface px-4 h-12 shadow-card focus-within:border-accent">
            <Icon name="search" size={18} class="text-subtle" />
            <span class="sr-only">{t(locale, 'home.searchLabel')}</span>
            <input
              id="tool-search"
              type="search"
              role="combobox"
              aria-expanded="false"
              aria-controls="search-results"
              aria-autocomplete="list"
              aria-keyshortcuts="/"
              autocomplete="off"
              placeholder={t(locale, 'home.searchPlaceholder')}
              class="flex-1 bg-transparent outline-none text-base placeholder:text-subtle"
            />
          </label>
          <ul
            id="search-results"
            role="listbox"
            aria-label={t(locale, 'home.searchLabel')}
            data-no-results={t(locale, 'home.noResults')}
            hidden
            class="absolute inset-x-0 top-full z-20 mt-2 max-h-80 overflow-auto rounded-lg border border-line bg-surface shadow-pop p-1"
          />
        </div>
        <p class="mt-3 text-sm text-subtle">{t(locale, 'home.toolCount', { count: TOOLS.length })}</p>
      </section>

      <section class="mt-2">
        <h2 class="text-lg font-semibold tracking-tight mb-4">{t(locale, 'home.popular')}</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {popular.map((tool) => (
            <ToolCard tool={tool} locale={locale} />
          ))}
        </div>
      </section>

      {homeSections.map(({ id, preview, total }) => (
        <section class="mt-10">
          <div class="flex items-center justify-between gap-4 mb-4">
            <h2 class="text-lg font-semibold tracking-tight">
              <a href={localePath(locale, 'c', id)} class="hover:text-accent">
                {CATEGORIES[id].name[locale]}
              </a>
            </h2>
            {total > preview.length && (
              <a
                href={localePath(locale, 'c', id)}
                class="shrink-0 inline-flex items-center gap-1 text-sm text-accent hover:underline"
              >
                {t(locale, 'home.viewAll', { count: total })}
                <Icon name="arrow-right" size={14} />
              </a>
            )}
          </div>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {preview.map((tool) => (
              <ToolCard tool={tool} locale={locale} />
            ))}
          </div>
        </section>
      ))}
    </div>

    <script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
    <script>
      interface SearchEntry {
        url: string;
        icon: string;
        name: string;
        haystack: string;
      }

      const root = document.querySelector<HTMLElement>('[data-search-root]');
      const input = document.getElementById('tool-search') as HTMLInputElement | null;
      const list = document.getElementById('search-results') as HTMLUListElement | null;
      const dataEl = document.getElementById('search-index');

      if (root && input && list && dataEl) {
        const entries: SearchEntry[] = JSON.parse(dataEl.textContent || '[]');
        const noResultsText = list.dataset.noResults ?? '';
        const MAX_RESULTS = 8;
        let items: SearchEntry[] = [];
        let active = -1;

        const close = () => {
          list.hidden = true;
          input.setAttribute('aria-expanded', 'false');
          input.removeAttribute('aria-activedescendant');
          items = [];
          active = -1;
        };

        const setActive = (index: number) => {
          active = index;
          list.querySelectorAll<HTMLLIElement>('[role="option"]').forEach((el, i) => {
            const isActive = i === active;
            el.setAttribute('aria-selected', String(isActive));
            el.classList.toggle('bg-surface-2', isActive);
          });
          if (active >= 0) input.setAttribute('aria-activedescendant', `search-result-${active}`);
          else input.removeAttribute('aria-activedescendant');
        };

        const open = (matches: SearchEntry[]) => {
          items = matches;
          list.innerHTML = '';
          if (!matches.length) {
            const li = document.createElement('li');
            li.className = 'px-3 py-2 text-sm text-subtle';
            li.textContent = noResultsText;
            list.appendChild(li);
          } else {
            matches.forEach((entry, i) => {
              const li = document.createElement('li');
              li.id = `search-result-${i}`;
              li.setAttribute('role', 'option');
              li.setAttribute('aria-selected', 'false');
              li.className = 'rounded-md px-3 py-2 text-sm text-fg cursor-pointer hover:bg-surface-2';
              li.textContent = entry.name;
              li.addEventListener('mousedown', (e) => {
                e.preventDefault();
                window.location.assign(entry.url);
              });
              list.appendChild(li);
            });
          }
          list.hidden = false;
          input.setAttribute('aria-expanded', 'true');
          setActive(matches.length ? 0 : -1);
        };

        const search = (query: string) => {
          const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
          if (!terms.length) {
            close();
            return;
          }
          open(entries.filter((e) => terms.every((term) => e.haystack.includes(term))).slice(0, MAX_RESULTS));
        };

        input.addEventListener('input', () => search(input.value));
        input.addEventListener('focus', () => {
          if (input.value.trim()) search(input.value);
        });
        input.addEventListener('keydown', (e) => {
          if (list.hidden && e.key !== 'Escape') return;
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (items.length) setActive((active + 1) % items.length);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (items.length) setActive((active - 1 + items.length) % items.length);
          } else if (e.key === 'Enter') {
            if (active >= 0 && items[active]) {
              e.preventDefault();
              window.location.assign(items[active].url);
            }
          } else if (e.key === 'Escape') {
            close();
            input.blur();
          }
        });
        document.addEventListener('click', (e) => {
          if (!root.contains(e.target as Node)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey || e.defaultPrevented) return;
          const target = e.target as HTMLElement | null;
          if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
          e.preventDefault();
          input.focus();
        });
      }
    </script>
  </BaseLayout>
)}

{props.kind === 'category' && (
  <BaseLayout
    locale={locale}
    title={CATEGORIES[props.category].name[locale]}
    description={CATEGORIES[props.category].description[locale]}
    segments={['c', props.category]}
    jsonLd={[
      breadcrumbLd([
        { name: t(locale, 'breadcrumb.home'), path: localePath(locale) },
        { name: CATEGORIES[props.category].name[locale], path: localePath(locale, 'c', props.category) },
      ]),
    ]}
  >
    <div class="mx-auto max-w-5xl px-4 pt-6">
      <Breadcrumbs
        crumbs={[
          { name: t(locale, 'breadcrumb.home'), path: localePath(locale) },
          { name: CATEGORIES[props.category].name[locale], path: localePath(locale, 'c', props.category) },
        ]}
      />
      <h1 class="mt-6 text-3xl sm:text-4xl font-semibold tracking-tight">{CATEGORIES[props.category].name[locale]}</h1>
      <p class="mt-3 text-lg text-muted">{CATEGORIES[props.category].description[locale]}</p>
      <p class="mt-1 text-sm text-subtle">{t(locale, 'home.categoryCount', { count: categoryTools.length })}</p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {categoryTools.map((tool) => (
          <ToolCard tool={tool} locale={locale} />
        ))}
      </div>
    </div>
  </BaseLayout>
)}

{props.kind === 'static' &&
  (() => {
    const page = props.page;
    const content = STATIC_PAGES[page][locale];
    const crumbs = [
      { name: t(locale, 'breadcrumb.home'), path: localePath(locale) },
      { name: content.h1, path: localePath(locale, page) },
    ];
    const legalLabel: Record<StaticPageId, 'footer.about' | 'footer.privacyLink' | 'footer.terms' | 'footer.contact'> =
      {
        about: 'footer.about',
        privacy: 'footer.privacyLink',
        terms: 'footer.terms',
        contact: 'footer.contact',
      };
    return (
      <BaseLayout
        locale={locale}
        title={content.title}
        description={content.description}
        segments={[page]}
        jsonLd={[breadcrumbLd(crumbs)]}
      >
        <div class="mx-auto max-w-5xl px-4 pt-6">
          <Breadcrumbs crumbs={crumbs} />
          <header class="mt-6 max-w-3xl">
            <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">{content.h1}</h1>
            <p class="mt-3 text-lg text-muted text-pretty">{content.intro}</p>
          </header>

          {page === 'contact' && (
            <a
              href={`mailto:${CONTACT_EMAIL}`}
              class="mt-6 inline-flex h-11 items-center gap-2 rounded-md border border-line bg-surface px-4 text-[15px] font-medium hover:border-line-strong"
            >
              <Icon name="mail" size={18} class="text-accent" />
              {CONTACT_EMAIL}
            </a>
          )}

          <div class="mt-12 grid gap-10 max-w-3xl">
            {content.sections.map((s) => (
              <section class="prose-tool">
                <h2>{s.heading}</h2>
                {s.body.split('\n\n').map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            ))}
          </div>

          <p class="mt-10 text-xs text-subtle">{t(locale, 'tool.updated', { date: content.updated })}</p>

          <nav
            class="mt-10 pt-8 border-t border-line flex flex-wrap gap-4 text-sm"
            aria-label={t(locale, 'page.moreLinks')}
          >
            {STATIC_PAGE_IDS.filter((id) => id !== page).map((id) => (
              <a href={localePath(locale, id)} class="text-muted hover:text-fg">
                {t(locale, legalLabel[id])}
              </a>
            ))}
          </nav>
        </div>
      </BaseLayout>
    );
  })()}
